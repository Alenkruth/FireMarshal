[submodule "riscv-linux"]
	path = boards/default/linux
	url = git@github.com:firesim/linux.git
[submodule "opensbi"]
	path = boards/default/firmware/opensbi
	url = git@github.com:riscv/opensbi.git
[submodule "boards/default/distros/br/buildroot"]
	path = boards/default/distros/br/buildroot
	url = git@github.com:buildroot/buildroot.git
[submodule "wlutil/busybox"]
	path = wlutil/busybox
	url = git@github.com:mirror/busybox.git
[submodule "boards/firechip/drivers/icenet-driver"]
	path = boards/firechip/drivers/icenet-driver
	url = git@github.com:firesim/icenet-driver.git
[submodule "boards/firechip/drivers/iceblk-driver"]
	path = boards/firechip/drivers/iceblk-driver
	url = git@github.com:firesim/iceblk-driver.git
[submodule "boards/firechip/base-workloads/spec2017"]
	path = boards/firechip/base-workloads/spec2017
	url = git@github.com:Alenkruth/spec2017-workload.git
	branch = corefuzzing
